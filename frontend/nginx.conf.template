server {
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream $BACKEND_URL;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html names the hashed bundle; without this, browsers cache it
    # heuristically and keep loading the previous deploy's JS.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Vite assets are content-hashed, so a new deploy gets new file names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /api {
        # nginx defaults to 1 MB; exercise video uploads allow up to 100 MB (multer cap).
        client_max_body_size 110m;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
